# ==============================================================================
# SANJEEVANI FINANCE MANAGEMENT SYSTEM (SFMS) - ROOT CONFIGURATION
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Core API Backend Settings
# ------------------------------------------------------------------------------
PORT=4000
API_PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Security & JWT Encryption Keys (SRS §82)
# Change these values in production to strong, cryptographically generated secrets!
# ------------------------------------------------------------------------------
JWT_SECRET=sanjeevani-finance-jwt-super-secret-key-2026-production-grade
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Enterprise PostgreSQL 16 Database Configuration (SRS §5)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanjeevani_finance
DB_USER=sfms_admin
DB_PASSWORD=SanjeevaniSecret2026!
DATABASE_URL=postgresql://sfms_admin:SanjeevaniSecret2026!@localhost:5432/sanjeevani_finance

# ------------------------------------------------------------------------------
# 4. Redis In-Memory Cache & Session Queue (SRS §6)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Frontend Admin Web Portal
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

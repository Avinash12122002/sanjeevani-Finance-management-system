# ==============================================================================
# SANJEEVANI FINANCE - BACKEND API ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_URL=postgresql://user:password@localhost:5432/sanjeevani_finance
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanjeevani_finance
DB_USER=sfms_admin
DB_PASSWORD=your-password
